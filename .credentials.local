SUPABASE_URL=https://ldkeeiefpsrncfxmgyhr.supabase.co
# Personal access token (account-wide, powerful — rotate periodically):
SUPABASE_ACCESS_TOKEN=sbp_3b53368513dd98531f4cfe9392a867f5112742be
