# Commission workbooks: one Google Sheet per rep the reconciliation sheet does
# not carry, with a TAB PER PAYOUT CYCLE ("8/15/2026" pays July). JSON array of
# { id, rep, vertical }. `rep` is needed only for the three-column layout
# (PATIENT | DEVICE | COMMISSION); a workbook with its own REP column names the
# rep per row. Lines are ignored wherever the reconciliation sheet already pays
# that rep for that month, so listing a covered workbook cannot double anyone.
COMMISSION_WORKBOOKS=[{"id":"13IDR3aG2CLpxbwtYUtkKkYu7FJFG6Isx9NSl_SryYA8","rep":"Maylon Sanders","vertical":"PI"}]

