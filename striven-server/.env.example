# Copy to .env and fill in. NEVER commit the filled-in .env: it is gitignored
# because SUPABASE_SERVICE_KEY alone grants full read/write to a database that
# holds PHI, bypassing row-level security.
#
# Several of these can also live in the Supabase `app_config` table, which takes
# precedence and lets values change without a redeploy. See README.

# ── Striven API ──────────────────────────────────────────────────────────────
# Striven → Settings → API → "Enable API Access".
STRIVEN_CLIENT_ID=
STRIVEN_CLIENT_SECRET=

# Local dev server port. Vite proxies /api here (see vite.config.js).
PORT=4747

# ── Supabase ─────────────────────────────────────────────────────────────────
# The service key is the SERVICE ROLE key, not the anon key. It is the single
# most sensitive value in this file.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Shared secret guarding GET /api/refresh so only the cron job can trigger a
# cache rebuild.
REFRESH_TOKEN=

# ── Auto-PO ──────────────────────────────────────────────────────────────────
# AUTO_PO_KEY guards the cron entry point.
# AUTO_PO_MODE:       dry | live      (dry plans POs without creating them)
# AUTO_PO_DEMO_ONLY:  true | false    (true restricts it to DEMO orders)
AUTO_PO_KEY=
AUTO_PO_MODE=dry
AUTO_PO_DEMO_ONLY=true

# ── QuickBooks Online ────────────────────────────────────────────────────────
# QB_ENV: sandbox | production. The redirect URI must match the Intuit app.
QB_ENV=sandbox
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=

# ── Shippo (tracking) ────────────────────────────────────────────────────────
SHIPPO_TOKEN=

# ── Google Sheets sources ────────────────────────────────────────────────────
# Each workbook must be shared as "anyone with the link can view". The GID is
# the tab id from the sheet URL (#gid=...).
#
# COMMISSION_WORKBOOKS is a JSON array of {id,gid,label}.
COMMISSION_WORKBOOKS=
COMMISSION_RECON_SHEET_ID=
COMMISSION_RECON_GID=
AP_LEDGER_SHEET_ID=
AP_LEDGER_GID=
AR_REGISTER_SHEET_ID=
AR_REGISTER_GID=

# ── Striven labels ───────────────────────────────────────────────────────────
# Striven's API does not expose sales-order labels; this is the fallback source
# the portal reads them from.
STRIVEN_LABELS_URL=
